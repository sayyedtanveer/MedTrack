APP_NAME=MedTrack ERP
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
DATABASE_SYNC_URL=postgresql://erp_user:erp_password@localhost:5432/erp_db
DATABASE_URL=postgresql+asyncpg://erp_user:erp_password@localhost:5432/erp_db
DEBUG=true
EMAIL_BACKEND=resend
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5000
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7
JWT_SECRET_KEY=change-this-to-a-long-random-development-secret
LOG_FORMAT=console
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=10
REDIS_URL=redis://localhost:6379/0
RESEND_API_KEY=
RESEND_FROM_EMAIL=dev@example.com
UPLOAD_DIR=./uploads