# ─────────────────────────────────────────────
# MedTrack ERP – Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
ENVIRONMENT=development
APP_NAME="MedTrack ERP"
APP_VERSION="0.1.0"
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://erp_user:erp_password@localhost:5432/erp_db
# Sync URL used only by Alembic migrations
DATABASE_SYNC_URL=postgresql://erp_user:erp_password@localhost:5432/erp_db

# ── JWT ──────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# ── CORS ─────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Required in production (comma-separated, no wildcard allowed)
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# ── File Storage ─────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── Redis (optional – for future event bus / cache) ───
REDIS_URL=redis://localhost:6379/0

# ── Email (Resend — https://resend.com) ──────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Frontend URL (for email links) ───────────
FRONTEND_URL=http://localhost:5173
