{
  "version": "0.2.0",
  "configurations": [
    {
      // Run backend only with debugger attached (breakpoints work)
      "name": "Backend FastAPI (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.app.main:app",
        "--host", "0.0.0.0",
        "--port", "8001",
        "--reload"
      ],
      "jinja": true,
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Run backend + frontend together via `npm run dev` (uses concurrently)
      "name": "Full Stack (backend + frontend)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(http://localhost:\\d+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
