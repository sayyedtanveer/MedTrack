## API Integration (Type-Safe Services)

**Type-safe API clients with full request/response types.**

```typescript
// ✅ CORRECT: Fully typed API service
interface Material {
  id: string;
  code: string;
  name: string;
  quantity: number;
}

interface CreateMaterialInput {
  code: string;
  name: string;
  unit_id: string;
}

export const materialApi = {
  async list(): Promise<Material[]> {
    const response = await api.get<Material[]>("/materials");
    return response.data;
  },
  
  async get(id: string): Promise<Material> {
    const response = await api.get<Material>(`/materials/${id}`);
    return response.data;
  },
  
  async create(input: CreateMaterialInput): Promise<Material> {
    const response = await api.post<Material>("/materials", input);
    return response.data;
  }
};

// ❌ WRONG: Loose API integration
export const listMaterials = () => {
  return api.get("/materials");  // No type safety
};

export const createMaterial = (data) => {
  return api.post("/materials", data);  // Any type
};
```

