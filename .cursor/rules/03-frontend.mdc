# Frontend: React, TypeScript, Vite

**Reference:** [`AGENTS.md`](../../AGENTS.md) Section 8 | [`FRONTEND_STANDARDS.md`](../../docs/ai-guidelines/FRONTEND_STANDARDS.md)

---

## TypeScript Strict Mode (Mandatory)

**All TypeScript code must be fully typed. No `any` types.**

```typescript
// ✅ CORRECT: Fully typed
interface MaterialListProps {
  materials: Material[];
  loading: boolean;
  onSelect: (id: string) => void;
}

export const MaterialList: React.FC<MaterialListProps> = ({
  materials,
  loading,
  onSelect
}) => {
  if (loading) return <LoadingSpinner />;
  return <div>{/* JSX */}</div>;
};

// ❌ WRONG: No types or 'any'
export const MaterialList = ({ materials, loading, onSelect }: any) => {
  // Type safety defeated
};

// ❌ WRONG: Untyped props
export const MaterialList = (props) => {
  // No TypeScript help
};
```

