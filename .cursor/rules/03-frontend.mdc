## Custom Hooks (Logic Extraction)

**Extract logic into reusable, typed hooks.**

```typescript
// ✅ CORRECT: Custom hook with types
interface UseMaterialsReturn {
  materials: Material[];
  loading: boolean;
  error: Error | null;
  refetch: () => Promise<void>;
}

export const useMaterials = (): UseMaterialsReturn => {
  const [materials, setMaterials] = React.useState<Material[]>([]);
  const [loading, setLoading] = React.useState(true);
  const [error, setError] = React.useState<Error | null>(null);
  
  const fetch = async () => {
    try {
      const data = await api.materials.list();
      setMaterials(data);
    } catch (err) {
      setError(err instanceof Error ? err : new Error("Unknown error"));
    } finally {
      setLoading(false);
    }
  };
  
  React.useEffect(() => {
    fetch();
  }, []);
  
  return { materials, loading, error, refetch: fetch };
};

// ❌ WRONG: Untyped hook
export const useMaterials = () => {
  const [materials, setMaterials] = React.useState([]);
  // No type info for return value
};
```

