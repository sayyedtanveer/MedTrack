## React Components (Functional Only)

**Use functional components with hooks. Never class components.**

```typescript
// ✅ CORRECT: Functional with hooks
export const SalesOrderForm: React.FC<SalesOrderFormProps> = ({ onSubmit }) => {
  const [loading, setLoading] = React.useState(false);
  const [error, setError] = React.useState<Error | null>(null);
  
  const handleSubmit = async (data: SalesOrderInput) => {
    setLoading(true);
    try {
      await api.orders.create(data);
      onSubmit?.();
    } catch (err) {
      setError(err instanceof Error ? err : new Error("Unknown error"));
    } finally {
      setLoading(false);
    }
  };
  
  return <form onSubmit={handleSubmit}>{/* JSX */}</form>;
};

// ❌ WRONG: Class component
class SalesOrderForm extends React.Component {
  render() {
    return <form>{/* JSX */}</form>;
  }
}
```

