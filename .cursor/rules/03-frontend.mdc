## Accessibility Requirements

**Components must be accessible:**

```typescript
// ✅ CORRECT: Accessible component
export const MaterialTable: React.FC<MaterialTableProps> = ({ materials }) => {
  return (
    <table role="table" aria-label="Materials">
      <tbody>
        {materials.map(m => (
          <tr 
            key={m.id} 
            role="button" 
            tabIndex={0}
            onKeyPress={(e) => e.key === "Enter" && handleSelect(m.id)}
            onClick={() => handleSelect(m.id)}
          >
            <td>{m.code}</td>
          </tr>
        ))}
      </tbody>
    </table>
  );
};

// ❌ WRONG: Not accessible
export const MaterialTable = ({ materials }) => {
  return (
    <div>
      {materials.map(m => (
        <div onClick={() => handleSelect(m.id)}>
          {m.code}
        </div>
      ))}
    </div>
  );
};
```

