## Testing (Vitest + React Testing Library)

```typescript
// ✅ CORRECT: Component test
import { render, screen } from "@testing-library/react";
import { MaterialList } from "./MaterialList";

describe("MaterialList", () => {
  it("displays loading spinner while loading", () => {
    const { getByRole } = render(
      <MaterialList materials={[]} loading={true} error={null} />
    );
    expect(getByRole("status")).toBeInTheDocument();
  });
  
  it("displays materials when loaded", () => {
    const materials = [{ id: "1", code: "MAT-001", name: "Steel" }];
    const { getByText } = render(
      <MaterialList materials={materials} loading={false} error={null} />
    );
    expect(getByText("MAT-001")).toBeInTheDocument();
  });
});
```

