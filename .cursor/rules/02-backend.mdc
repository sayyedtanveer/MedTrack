## Repositories (Multi-Tenant Queries)

**Repositories implement domain interfaces. All queries filter by tenant_id.**

```python
# ✅ CORRECT: Tenant-scoped queries
class MaterialRepository(IMaterialRepository):
    async def list_by_tenant(self, tenant_id: UUID) -> List[Material]:
        stmt = select(MaterialModel).where(
            MaterialModel.tenant_id == tenant_id,      # ← MANDATORY
            MaterialModel.is_deleted == False          # ← MANDATORY
        ).order_by(MaterialModel.created_at.desc())
        
        results = await self.session.execute(stmt)
        return [Material.from_model(m) for m in results.scalars()]

    async def get_by_id(
        self,
        tenant_id: UUID,
        material_id: UUID
    ) -> Material | None:
        stmt = select(MaterialModel).where(
            MaterialModel.tenant_id == tenant_id,
            MaterialModel.id == material_id,
            MaterialModel.is_deleted == False
        )
        result = await self.session.execute(stmt)
        model = result.scalars().first()
        return Material.from_model(model) if model else None

# ❌ WRONG: Missing tenant filter
async def list_by_tenant(self, tenant_id) -> List[Material]:
    stmt = select(MaterialModel).where(MaterialModel.status == "ACTIVE")
    # Could return other tenants' materials
```

