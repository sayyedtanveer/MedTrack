## FastAPI Routes

**Routes are thin translation layers. Business logic belongs in handlers, not routes.**

```python
# ✅ CORRECT: Route delegates to handler
@router.post("/materials")
async def create_material(
    req: CreateMaterialRequest,
    handler: MaterialHandlers = Depends()
) -> CreateMaterialResponse:
    cmd = CreateMaterialCommand(
        code=req.code,
        name=req.name,
        unit_id=req.unit_id
    )
    material_id = await handler.handle_create_material(cmd)
    return CreateMaterialResponse(id=str(material_id))

# ❌ WRONG: Business logic in route
@router.post("/materials")
async def create_material(req: CreateMaterialRequest) -> dict:
    # ❌ Business logic here
    if not req.code:
        raise ValueError()
    material = Material(code=req.code, name=req.name)
    await db.save(material)
    return {"id": str(material.id)}
```

