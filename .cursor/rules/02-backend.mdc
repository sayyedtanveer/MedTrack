## Command Handlers (Write Operations)

```python
@dataclass
class CreateMaterialCommand:
    code: str
    name: str
    unit_id: UUID

async def handle_create_material(self, cmd: CreateMaterialCommand) -> UUID:
    tenant_id = get_tenant_id()  # From JWT context
    
    # 1. Validate input
    existing = await self.repo.get_by_code(tenant_id, cmd.code)
    if existing:
        raise DuplicateMaterialCodeError(cmd.code)
    
    # 2. Create entity (domain logic)
    material = Material(id=uuid.uuid4(), code=cmd.code, name=cmd.name)
    
    # 3. Persist
    material_id = await self.repo.save(material)
    
    # 4. Publish events (for downstream subscribers)
    await self.event_dispatcher.publish([
        MaterialCreatedEvent(material_id=material_id)
    ])
    
    # 5. Log
    logger.info(
        "Material created",
        extra={
            "material_id": str(material_id),
            "tenant_id": str(tenant_id),
            "code": cmd.code
        }
    )
    
    return material_id
```

---

## Query Handlers (Read Operations)

```python
@dataclass
class GetMaterialQuery:
    material_id: UUID

async def handle_get_material(self, query: GetMaterialQuery) -> MaterialResponse:
    tenant_id = get_tenant_id()  # From JWT context
    
    material = await self.repo.get_by_id(tenant_id, query.material_id)
    if not material:
        raise MaterialNotFoundError(query.material_id)
    
    return MaterialResponse.from_entity(material)
```

**Rule:** Queries return DTOs, not entities. No side effects.

