## Multi-Tenant Queries (Mandatory Filter)

**Every SELECT query must filter by tenant_id AND is_deleted.**

```python
# ✅ CORRECT: Tenant filter + soft delete check
async def list_by_tenant(self, tenant_id: UUID) -> List[Material]:
    stmt = select(MaterialModel).where(
        MaterialModel.tenant_id == tenant_id,      # ← MANDATORY
        MaterialModel.is_deleted == False          # ← MANDATORY
    ).order_by(MaterialModel.created_at.desc())
    
    results = await session.execute(stmt)
    return [Material.from_model(m) for m in results.scalars()]

async def get_by_id(self, tenant_id: UUID, material_id: UUID) -> Material | None:
    stmt = select(MaterialModel).where(
        MaterialModel.tenant_id == tenant_id,      # ← MANDATORY
        MaterialModel.id == material_id,
        MaterialModel.is_deleted == False          # ← MANDATORY
    )
    result = await session.execute(stmt)
    model = result.scalars().first()
    return Material.from_model(model) if model else None

# ❌ WRONG: Missing tenant or soft delete filter
async def list_all(self) -> List[Material]:
    stmt = select(MaterialModel)  # ← Gets all tenants + deleted!
    results = await session.execute(stmt)
    return results

async def get_by_code(self, code: str) -> Material | None:
    stmt = select(MaterialModel).where(MaterialModel.code == code)
    # ← Missing tenant filter (cross-tenant leak)
```

