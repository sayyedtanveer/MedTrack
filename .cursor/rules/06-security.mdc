## Authorization (RBAC)

### Role-Based Permissions

```python
# ✅ CORRECT: RBAC matrix
PERMISSIONS = {
    # (module, action) → allowed roles
    ("material", "create"): ["ADMIN", "MANAGER", "STOREKEEPER"],
    ("material", "delete"): ["ADMIN", "MANAGER"],
    ("work_order", "release"): ["ADMIN", "MANAGER", "PLANNER"],
    ("work_order", "complete"): ["OPERATOR", "WORKER"],
    ("sales_order", "approve"): ["ADMIN", "MANAGER"],
}

async def check_permission(
    user_role: str,
    module: str,
    action: str
) -> bool:
    allowed_roles = PERMISSIONS.get((module, action), [])
    return user_role in allowed_roles
```

### Permission Enforcement (Route)

```python
# ✅ CORRECT: RBAC dependency
async def require_permission(module: str, action: str):
    async def permission_check(user = Depends(get_current_user)):
        has_permission = await permission_service.check(
            user_role=user.role,
            module=module,
            action=action
        )
        if not has_permission:
            logger.warning(
                "Access denied",
                extra={"user_id": str(user.id), "module": module, "action": action}
            )
            raise HTTPException(status_code=403, detail="Access denied")
        return user
    return permission_check

@router.post("/materials")
async def create_material(
    req: CreateMaterialRequest,
    user = Depends(require_permission("material", "create")),
    handler = Depends()
):
    return await handler.handle_create_material(req)

# ❌ WRONG: No RBAC
@router.post("/materials")
async def create_material(req, user = Depends()):
    # ❌ Any authenticated user can create
    return await handler.handle_create_material(req)
```

