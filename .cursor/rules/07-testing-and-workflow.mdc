## Test Patterns

### Unit Test (Pure Logic)

```python
@pytest.mark.unit
def test_bom_prevents_duplicate_components():
    bom = BOM(id=uuid.uuid4(), lines=[])
    line = BOMLine(material_id=uuid.uuid4(), quantity=Decimal("10"))
    
    bom.add_line(line)  # First add succeeds
    
    with pytest.raises(DuplicateComponentError):
        bom.add_line(line)  # Duplicate raises error
```

### Integration Test (With Database)

```python
@pytest.mark.asyncio
@pytest.mark.integration
async def test_material_tenant_isolation(db_session):
    tenant1_id = uuid.uuid4()
    tenant2_id = uuid.uuid4()
    
    repo = MaterialRepository(db_session)
    
    # Tenant1 creates material
    mat1 = await repo.create(tenant1_id, Material(code="MAT-001", ...))
    
    # Tenant2 cannot see it
    result = await repo.get_by_id(tenant2_id, mat1.id)
    assert result is None
```

### E2E Test (Full API)

```python
@pytest.mark.asyncio
@pytest.mark.e2e
async def test_create_material_via_api(client: AsyncClient, auth_headers):
    response = await client.post(
        "/api/v1/materials",
        json={"code": "MAT-001", "name": "Steel", "unit_id": str(uuid.uuid4())},
        headers=auth_headers
    )
    assert response.status_code == 201
    assert response.json()["code"] == "MAT-001"
```

