## Subcontracting Rules

**Issued materials ≠ Consumed materials (track separately).**

```python
# ✅ CORRECT: Track issued, consumed, returned separately
class SubcontractOrder:
    issued_qty: Decimal  # Sent to subcontractor
    consumed_qty: Decimal  # Used by subcontractor
    returned_qty: Decimal  # Returned by subcontractor
    
    async def issue_materials(self, qty: Decimal) -> None:
        """Issue materials to subcontractor."""
        await self.inventory.consume(material_id=self.material_id, qty=qty)
        self.issued_qty += qty
        self.events.append(MaterialIssuedEvent(self.id, qty))
    
    async def receive_output(self, qty: Decimal) -> None:
        """Receive finished goods from subcontractor."""
        await self.inventory.receive(
            material_id=self.output_material_id,
            qty=qty
        )
        self.consumed_qty += qty
        self.events.append(OutputReceivedEvent(self.id, qty))
    
    async def return_materials(self, qty: Decimal) -> None:
        """Subcontractor returns unused materials."""
        await self.inventory.receive(
            material_id=self.material_id,
            qty=qty
        )
        self.returned_qty += qty
        self.events.append(MaterialReturnedEvent(self.id, qty))
```

