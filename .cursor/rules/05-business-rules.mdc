## GRN Rules (Procurement)

**GRN quantity ≤ PO quantity.**

```python
# ✅ CORRECT: Validate GRN qty
class GoodReceiptNote:
    async def create_grn(self, po_id: UUID, line_id: UUID, qty: Decimal) -> UUID:
        po = await self.po_repo.get_by_id(po_id)
        po_line = next((l for l in po.lines if l.id == line_id), None)
        
        if not po_line:
            raise POLineNotFoundError(line_id)
        
        # Total received so far + new qty
        total_received = po_line.grn_qty_received + qty
        
        if total_received > po_line.qty:
            raise ExcessiveGRNError(
                f"GRN qty {qty} would exceed PO qty {po_line.qty}"
            )
        
        grn = GoodReceiptNote(po_id=po_id, line_id=line_id, qty=qty)
        grn_id = await self.grn_repo.save(grn)
        
        # Add to inventory
        await self.inventory.receive(
            material_id=po_line.material_id,
            quantity=qty,
            reference_type="grn",
            reference_id=grn_id
        )
        
        return grn_id
```

