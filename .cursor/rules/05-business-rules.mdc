## Inventory Reservation Rules

### Rule 1: Reserve on WO Release

```python
# ✅ CORRECT: Reserve materials when WO released
class WorkOrder:
    async def release(self) -> None:
        """Release WO and reserve materials."""
        if self.status != WorkOrderStatus.DRAFT:
            raise InvalidStateTransitionError()
        
        # Validate stock available
        for line in self.lines:
            available = await self.inventory.get_available_stock(line.material_id)
            if available < line.required_quantity:
                raise InsufficientStockError(line.material_id, line.required_quantity)
        
        # Reserve materials
        for line in self.lines:
            await self.inventory.reserve(
                material_id=line.material_id,
                quantity=line.required_quantity,
                reference_type="work_order",
                reference_id=self.id
            )
        
        self.status = WorkOrderStatus.RELEASED
        self.events.append(WorkOrderReleasedEvent(self.id))
```

### Rule 2: Consume on WO Completion

```python
# ✅ CORRECT: Consume (decrease inventory) on completion
class WorkOrder:
    async def complete(self) -> None:
        """Complete WO and consume materials."""
        if self.status != WorkOrderStatus.STARTED:
            raise InvalidStateTransitionError()
        
        # Consume materials (remove from inventory)
        for line in self.lines:
            await self.inventory.consume(
                material_id=line.material_id,
                quantity=line.actual_consumed,
                reference_type="work_order",
                reference_id=self.id
            )
            
            # Handle scrap
            if line.actual_scrap > 0:
                await self.inventory.scrap(
                    material_id=line.material_id,
                    quantity=line.actual_scrap
                )
        
        self.status = WorkOrderStatus.COMPLETED
        self.events.append(WorkOrderCompletedEvent(self.id))
```

